+    r"^(?P<indent>\s*)(?:[-*+]\s+|\d+[.)]\s+)?"
+    r"(?:\*\*|__|\*|_)?\s*"
+    r"(?P<field>persona|goal|entry(?:\s+point)?|steps?|decisions?(?:\s+points?)?"
